# Dependencies
node_modules/
.venv-soup/
.tools/soup/

# Legacy claude-mem store (disabled; preserve local residue only, never pushed)
.claude-mem/

# Runtime memory files (fresh on every clone)
.claude/MEMORY.md
.claude/ONBOARDING.md
.claude/memory/

# Local operator/client memory — confidential, never pushed
memory/memory.md
memory/improvement-backlog.md
memory/archive/
memory/clients/

# Client source documents — temp drop zone and per-client reference
reference/*
!reference/README.md

# Raw client PDFs awaiting conversion — confidential, never pushed
pdf-source/*
!pdf-source/README.md

# Generated deliverables — client-specific output
deliverables/*
!deliverables/README.md

# Local document engines — portable binaries (large, platform-specific)
engines/*
!engines/README.md

# Python bytecode — machine/version-specific, auto-regenerated
__pycache__/
*.pyc

# Scratch workspace — eval runs, temp tooling, throwaway analysis (never pushed)
workspace/

# Project backup archives — git history is the backup
*.zip

# Stray temp / scratch outputs accidentally written to repo root
tmp-*.txt
*tmp-*-output.txt
*tmp-*cols.txt

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Local Python environment
.venv/
